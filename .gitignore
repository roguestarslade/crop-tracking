# ───────────────────────────────
# 🔧 C / C++ Build Artifacts
# ───────────────────────────────

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# ───────────────────────────────
# 🦀 Rust Artifacts
# ───────────────────────────────

# Generated by Cargo
/target/
/Cargo.lock
/rust/target/
/rust/Cargo.lock

# If using cargo-edit
/.cargo-ok

# Executables and binaries
*.rlib
*.d
*.dSYM/

# Rust analyzer metadata
/.rustc_info.json
/.rust-analyzer.json

# Backup files
*~
*.swp
*.swo

# Unit test / benchmarking output
/tests/output/

# Clippy and IDE temp
/target-debug/
/target-release/

# ───────────────────────────────
# 📁 General VSCode / System Stuff
# ───────────────────────────────

# VSCode dev containers
.vscode/
#.devcontainer/

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
*.log
*.tmp

# VSCode workspace configuration (✅ include settings/launch/tasks/extensions)
!.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# VSCode machine-generated trash (❌ exclude this)
.vscode/*.code-workspace
.vscode/*.db
.vscode/*.log
.vscode/*.bak
.vscode/*.tmp
.vscode/history/

