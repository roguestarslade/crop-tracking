{
    "name": "crop-tracking",
    "context": "..",
    "dockerFile": "../Dockerfile",
    "workspaceFolder": "/crop-tracking",
    "workspaceMount": "source=${localWorkspaceFolder},target=/crop-tracking,type=bind",
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly",
        "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig_host,type=bind,readonly",
        "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly",
        "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig_host,type=bind,readonly"
    ],
    "postCreateCommand": "chmod 700 /root/.ssh && chmod 600 /root/.ssh/config && [ -f /root/.gitconfig_host ] && cp /root/.gitconfig_host /root/.gitconfig || echo '⚠️  No .gitconfig found on host'",
    "extensions": [
        "ms-vscode.cpptools",
        "rust-lang.rust-analyzer",
        "zxh404.vscode-proto3",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers"
    ]
}
