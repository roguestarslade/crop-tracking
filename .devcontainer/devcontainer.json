{
    "name": "crop-tracking",
    "context": "..",
    "dockerFile": "../Dockerfile",
    "runArgs": [
        "--user",
        "1000:1000"
    ],
    "workspaceFolder": "/crop-tracking",
    "workspaceMount": "source=${localWorkspaceFolder},target=/crop-tracking,type=bind",
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly",
        "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig_host,type=bind,readonly"
    ],
    "postCreateCommand": "chmod 700 /root/.ssh && chmod 600 /root/.ssh/config && chmod 600 /root/.ssh/id_ed25519 && chmod 644 /root/.ssh/id_ed25519.pub && [ -f /home/vscode/.gitconfig_host ] && cp /home/vscode/.gitconfig_host /root/.gitconfig || echo '⚠️  No .gitconfig found on host'",
    "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n",
        "editor.formatOnSave": true
    },
    "extensions": [
        "ms-vscode.cpptools",
        "rust-lang.rust-analyzer",
        "zxh404.vscode-proto3",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers"
    ]
}
